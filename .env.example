# Alle Schlüssel stehen NUR in dieser Datei (.env), nie im Code.
# Die Datei .env wird NICHT zu GitHub hochgeladen.
# Das meiste füllt "python setup.py" automatisch für dich aus.

# --- Claude (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=

# --- Google (ein gemeinsamer Zugang für beide Konten) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail Konten (werden von "python setup.py" eingetragen) ---
GMAIL_PRIVAT_REFRESH_TOKEN=
GMAIL_HEADNECK_REFRESH_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: Beschreibung je Postfach (hilft Claude beim Sortieren) ---
PRIVAT_CONTEXT=Privates Postfach eines Schülers. Wichtig sind Schule, Lehrer, Prüfungen, Fristen, Zahlungen, Verträge und Behörden.
HEADNECK_CONTEXT=Postfach von headneckmasterclass.com, einem Kursanbieter. Kursanfragen und Kursanmeldungen sind wichtig.

# --- Optional: Name unter den Antwortentwürfen ---
PRIVAT_SENDER_NAME=
HEADNECK_SENDER_NAME=

# --- Optional: Einstellungen ---
# Modelle
MODEL_CLASSIFY=claude-haiku-5-5
MODEL_DRAFT=claude-sonnet-5-5
# Wie oft prüfen (Minuten) und um wie viel Uhr (Wien) die Zusammenfassung kommt
CHECK_INTERVAL_MINUTES=30
DIGEST_HOUR=7
# Wie viele Tage zurück neue Mails betrachtet werden, und wie viele Mails pro Durchlauf
LOOKBACK_DAYS=2
MAX_MAILS_PER_RUN=25
# 1 = nur ansehen und ausgeben, nichts verändern, nichts senden (zum Testen)
DRY_RUN=0
